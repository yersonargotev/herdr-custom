+#[test]
+fn visual_trial_branch_and_changes_use_opposite_edges() {
+    use crate::ui::{ResolvedToken, ResolvedTokenKind};
+    let config = ClientShellConfig::from_config(&Config::default());
+    for width in [18, 24, 36] {
+        for status in ["clean", "+2 · ~3"] {
+            let area = Rect::new(0, 0, width, 2);
+            let mut buffer = Buffer::empty(area);
+            let token = |text: &str| ResolvedToken {
+                kind: ResolvedTokenKind::Custom(text.into()),
+                style: Default::default(),
+            };
+            super::super::sidebar::render_workspace_rows(
+                &mut buffer,
+                area,
+                AgentStatus::Idle,
+                Default::default(),
+                &WorkspaceEntry {
+                    index: 0,
+                    indented: false,
+                    last_child: false,
+                },
+                vec![
+                    vec![token("dots")],
+                    vec![
+                        ResolvedToken {
+                            kind: ResolvedTokenKind::Branch("main".into()),
+                            style: Default::default(),
+                        },
+                        token(status),
+                    ],
+                ],
+                true,
+                false,
+                false,
+                false,
+                &config.palette,
+            );
+            let text = (0..width)
+                .map(|x| buffer[(x, 1)].symbol())
+                .collect::<String>();
+            assert!(text.contains("main"), "{text}");
+            assert!(text.ends_with(&format!("{status}  ")), "{text}");
+            assert_eq!(buffer[(3, 1)].symbol(), "m");
+        }
+    }
+}
