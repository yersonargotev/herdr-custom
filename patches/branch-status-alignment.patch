+#[test]
+fn git_branch_alignment_uses_token_identity_and_handles_narrow_spaces() {
+    let configured: crate::config::SpacesSidebarConfig = toml::from_str(
+        r#"
+rows = [["$gitbranch", "$gitclean"]]
+"#,
+    )
+    .unwrap();
+    for branch in [Some("main"), None] {
+        let mut tokens = std::collections::HashMap::new();
+        if let Some(branch) = branch {
+            tokens.insert("gitbranch".into(), branch.into());
+        }
+        tokens.insert("gitclean".into(), "clean".into());
+        let rows = crate::ui::sidebar_space_rows(
+            &configured,
+            crate::ui::SpaceTokenContext {
+                workspace: "dots",
+                branch: None,
+                state_text: "idle",
+                ahead_behind: None,
+                tokens: &tokens,
+                suppress_git_details: false,
+            },
+        );
+        let config = ClientShellConfig::from_config(&Config::default());
+        for width in [1, 4, 8, 18, 36] {
+            let area = Rect::new(0, 0, width, 1);
+            let mut buffer = Buffer::empty(area);
+            super::super::sidebar::render_workspace_rows(
+                &mut buffer,
+                area,
+                AgentStatus::Idle,
+                Default::default(),
+                &WorkspaceEntry {
+                    index: 0,
+                    indented: false,
+                    last_child: false,
+                },
+                rows.clone(),
+                false,
+                false,
+                false,
+                false,
+                &config.palette,
+            );
+            let text = (0..width)
+                .map(|x| buffer[(x, 0)].symbol())
+                .collect::<String>();
+            if width >= 18 {
+                if branch.is_some() {
+                    assert!(text.starts_with(" main"), "{text}");
+                    assert!(text.ends_with("clean  "), "{text}");
+                } else {
+                    assert!(text.starts_with(" clean"), "{text}");
+                }
+            }
+        }
+    }
+}
