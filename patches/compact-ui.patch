@@ -0,0 +1,95 @@
+use super::*;
+
+#[test]
+fn visual_trial_selection_marks_and_tab_relationship_survive_composition() {
+    let mut projected = snapshot();
+    projected.tabs[0].label = "dots › codex".into();
+    projected.tabs[0].custom_label = true;
+    let mut other = projected.tabs[0].clone();
+    other.tab_id = "tab_2".into();
+    other.number = 2;
+    other.focused = false;
+    projected.tabs.push(other);
+    projected.agents.push(ClientShellAgent {
+        pane_id: "pane_1".into(),
+        workspace_id: "ws_1".into(),
+        tab_id: "tab_1".into(),
+        name: None,
+        display_agent: None,
+        agent: Some("codex".into()),
+        title: None,
+        terminal_title: None,
+        terminal_title_stripped: None,
+        agent_status: AgentStatus::Idle,
+        state_change_seq: 1,
+        state_labels: Vec::new(),
+        tokens: Vec::new(),
+        focused: true,
+    });
+    let config = ClientShellConfig::from_config(&Config::default());
+    let mut state = ClientShellState::new(config);
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    let frame = state.compose(140, 40).expect("desktop frame");
+    let text = frame
+        .cells
+        .iter()
+        .map(|cell| cell.symbol.as_str())
+        .collect::<String>();
+    assert!(text.contains("dots › codex"));
+    assert!(!text.contains("1 dots › codex"));
+    assert!(!text.contains("2 dots › codex"));
+    assert!(!text.contains("#1"));
+    assert!(frame.cells.iter().filter(|cell| cell.symbol == "▎").count() >= 2);
+    let first = state.hits.tabs[0].0;
+    let active = &frame.cells[usize::from(first.y * frame.width + first.x)];
+    assert_eq!(first.height, 1);
+    assert_eq!(active.modifier & Modifier::UNDERLINED.bits(), 0);
+    let separator = &frame.cells[usize::from(first.y * frame.width + first.right())];
+    assert_eq!(separator.symbol, "│");
+    let second = state.hits.tabs[1].0;
+    let inactive = &frame.cells[usize::from(second.y * frame.width + second.x)];
+    assert_eq!(inactive.modifier & Modifier::UNDERLINED.bits(), 0);
+    assert_eq!(state.hits.tabs[0].1, "tab_1");
+    assert_eq!(state.hits.tabs[1].1, "tab_2");
+}
+
+#[test]
+fn visual_trial_agent_state_stays_right_aligned() {
+    use crate::ui::{ResolvedToken, ResolvedTokenKind};
+    let config = ClientShellConfig::from_config(&Config::default());
+    for width in [18, 24, 36] {
+        for agent in ["codex", "claude", "pi"] {
+            for state in ["idle", "working", "blocked"] {
+                let rect = Rect::new(0, 0, width, 1);
+                let mut buffer = Buffer::empty(rect);
+                let row = super::super::agent_sidebar::AgentRow {
+                    pane_id: "pane_1".into(),
+                    status: AgentStatus::Idle,
+                    focused: true,
+                    rows: vec![vec![
+                        ResolvedToken {
+                            kind: ResolvedTokenKind::StateIcon,
+                            style: Default::default(),
+                        },
+                        ResolvedToken {
+                            kind: ResolvedTokenKind::Agent(agent.into()),
+                            style: Default::default(),
+                        },
+                        ResolvedToken {
+                            kind: ResolvedTokenKind::StateText(state.into()),
+                            style: Default::default(),
+                        },
+                    ]],
+                };
+                super::super::agent_sidebar::render_agent_row(&mut buffer, rect, &row, &config);
+                let text = (0..width)
+                    .map(|x| buffer[(x, 0)].symbol())
+                    .collect::<String>();
+                assert!(text.contains(agent), "{text}");
+                assert!(text.ends_with(&format!("{state} ")), "{text}");
+                assert!(!text.contains('·'), "{text}");
+            }
+        }
+    }
+}
